{
  "exclude": [
    "./node_modules",
    "./build"
  ],
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "outDir": "./build",
    "sourceMap": true,
    "target": "ES2020",
    "strict": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "baseUrl": "./",
    "paths": {
      "@locales/*": [
        "./src/_locales/*"
      ],
      "@apis/*": [
        "./src/apis/*"
      ],
      "@common/*": [
        "./src/common/*"
      ],
      "@components/*": [
        "./src/components/*"
      ],
      "@contexts/*": [
        "./src/contexts/*"
      ],
      "@images/*": [
        "./src/images/*"
      ],
      "@models/*": [
        "./src/models/*"
      ],
      "@stores/*": [
        "./src/stores/*"
      ],
      "@background": [
        "./src/modules/background/background"
      ],
      "@service": [
        "./src/modules/content/service/service"
      ],
      "@trakt": [
        "./src/modules/content/trakt/trakt"
      ],
      "@services": [
        "./src/services/services"
      ],
      "@services-apis": [
        "./src/services/apis"
      ],
      "@/*": [
        "./src/services/*",
        "./src/*"
      ]
    },
    "esModuleInterop": true,
    "moduleResolution": "Bundler"
  }
}

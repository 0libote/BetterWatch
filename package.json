{
  "name": "betterwatch",
  "version": "0.1.1",
  "description": "Chrome auto-skip and Trakt for Netflix, Prime Video, and HBO Max.",
  "author": "BetterWatch contributors",
  "private": true,
  "scripts": {
    "build": "bun scripts/build.ts",
    "dev": "bun scripts/build.ts --watch",
    "typecheck": "bun --bun tsc --noEmit",
    "test": "bun test --isolate",
    "check": "bun run repo:check && bun run typecheck && bun run test",
    "preview": "bun scripts/preview.ts",
    "repo:check": "bun scripts/check-repo.ts",
    "package:check": "bun scripts/verify-package.ts",
    "smoke:preview": "bun scripts/smoke-preview.ts",
    "release:check": "bun scripts/release-notes.ts --check",
    "release:sync": "bun scripts/sync-release-version.ts",
    "release:notes": "bun scripts/release-notes.ts"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource-variable/manrope": "^5.3.0",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@mui/system": "^9.5.0",
    "@mui/x-date-pickers": "^9.15.0",
    "date-fns": "^4.1.0",
    "deepmerge": "^4.3.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.2",
    "react-window": "^2.4.1",
    "rollbar": "^2.26.5",
    "type-fest": "^3.13.1",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@types/archiver": "^5.3.4",
    "@types/bun": "1.4.3",
    "@types/jsdom": "^30.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/webextension-polyfill": "^0.12.6",
    "archiver": "^5.3.2",
    "fflate": "^0.8.3",
    "jsdom": "^30.1.3",
    "typescript": "^5.8.3"
  },
  "license": "GPL-3.0-or-later",
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": ">=1.4.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/0libote/BetterWatch.git"
  },
  "bugs": {
    "url": "https://github.com/0libote/BetterWatch/issues"
  },
  "homepage": "https://github.com/0libote/BetterWatch#readme"
}
